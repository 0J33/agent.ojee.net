# ojee-home configuration. Copy to .env — .env is gitignored.
#
# Every value here is optional. With none of them set the hub runs a simulated
# air conditioner, and the entire UI — devices, scenes, automations, zones,
# activity — works exactly as it does against real hardware. That is the
# intended way to try it.

# ── hub ────────────────────────────────────────────────────────────────
HUB_PORT=8110
# 0.0.0.0 with host networking means "every interface". Narrow it to your
# tailnet address if the machine is on an untrusted network.
HUB_BIND=0.0.0.0
TIMEZONE=UTC

# Force the simulator even when a localKey is configured. Useful for demos
# and for developing without touching the real unit.
HUB_DEMO=0

# Seconds between polls of the device, and how long to wait after sending a
# command before trusting the next poll (the unit reports the OLD state for a
# moment after a change).
HUB_POLL_SECONDS=10
HUB_SETTLE_SECONDS=6
HUB_ACTIVITY_LIMIT=200

# ── the air conditioner ────────────────────────────────────────────────
# Leave AC_LOCAL_KEY blank to run the simulator. Setting it is what switches
# the hub to the real device.
AC_NAME=Living Room AC
AC_ROOM=Living Room

# The unit's address on your LAN, and its Wi-Fi module MAC with no separators.
# The MAC is also how the hub re-finds the unit when DHCP moves it.
AC_HOST=
AC_DEVICE_ID=

# Per-device 32-hex localKey. See docs/drivers/haier-ac.md for how to get it.
AC_LOCAL_KEY=

# Optional product code selecting a per-model attribute profile.
# Blank uses Haier-wide defaults.
AC_TYPE_ID=

# Swept when the AC stops answering on its last known address.
AC_SUBNET=192.168.1.0/24

# Setpoint limits. The protocol advertises 16..30, but a given unit's own
# remote may allow less. Blank keeps the profile's own range.
AC_TEMP_MIN=
AC_TEMP_MAX=

# ── Haier cloud account ────────────────────────────────────────────────
# Used ONLY to re-fetch a rotated localKey. Never written to the hub's data
# file. Leave blank unless you need that.
HAIER_USERNAME=
HAIER_PASSWORD=
# Dialling code of the country the ACCOUNT was registered in — not where the
# air conditioner is.
HAIER_REGION=

# ── presence ───────────────────────────────────────────────────────────
# Shared secret for POST /api/location. Blank disables the check, which is
# fine when the hub is tailnet-only and nothing else can reach it.
#
# Mounted in ojee-console the console asserts identity itself, so the phone
# app needs no token at all.
HOME_LOCATION_TOKEN=
